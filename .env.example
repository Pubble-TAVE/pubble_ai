# 복사해서 .env로 쓰기 (.env는 git에 안 올라감)
LLM_PRIMARY=api             # api (Claude) | local (자체 모델)
LLM_FALLBACK=api            # api | none (local일 때 대체)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=medium        # 대화 10개 low/medium 비교 후 medium으로 결정
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_MODEL=qwen3-1.7b-pubble
LLM_MAX_RETRIES=1
VERIFY_TIMEOUT=10           # 검증기 시간 초과(초) → 실패 처리

# 데이터 파이프라인 (scripts/make_dialogs.py)
GEMINI_API_KEY=             # 대화 생성 (연 크레딧)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
